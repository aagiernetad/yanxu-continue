# 研序（YanXu）环境变量示例
# 复制为 .env 后按本机实际服务地址和密钥调整，不要提交真实密钥

# LLM 配置
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=
LLM_QWEN_MAX=qwen-max
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=4096

# 本地单 worker 任务调度；持久化目录默认 app/data
MAX_ACTIVE_TASKS=4
TASK_TIMEOUT_SECONDS=600
# 同一 run 的累计调用上限，规划/修改计划也计入模型次数，确认后不重置
MAX_MODEL_CALLS=40
MAX_TOOL_CALLS=50
# 整轮共享的联网搜索上限；达到后停止搜索并用已有证据收尾，不强制用满
MAX_SEARCH_CALLS=5
MAX_DELEGATIONS=8
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Tavily 配置
# 在 https://app.tavily.com/ 注册账号，然后创建API KEY
TAVILY_API_KEY=

# RAGFlow 配置
RAGFLOW_API_URL=http://your-ragflow-host
RAGFLOW_API_KEY=

# MySQL 配置
# 使用仅对业务库拥有 SELECT 权限的专用账号，连接你自己的业务数据库
MYSQL_USER=deepsearch_reader
MYSQL_PASSWORD=
MYSQL_DATABASE=deepsearch_db
MYSQL_HOST=localhost
# 按本机 MySQL 实际监听端口填写
MYSQL_PORT=3307
# 与业务数据库字符集保持一致，保证中文数据按 utf8mb4 读写
MYSQL_CHARSET=utf8mb4
MYSQL_COLLATION=utf8mb4_unicode_ci
MYSQL_SQL_MODE=TRADITIONAL

# 本地知识库：向量化与重排服务需按实际服务地址配置
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_BASE_URL=
RAG_EMBEDDING_MODEL=text-embedding-v4
RAG_EMBEDDING_DIM=512
RAG_RERANK_BASE_URL=
RAG_RERANK_MODEL=qwen3-rerank

# 独立 RAG 问答命令使用的生成模型配置
RAG_GENERATION_API_KEY=
RAG_GENERATION_BASE_URL=
RAG_GENERATION_MODEL=qwen-max

# 可选：Jev 证据有效性评估，留空时跳过
TYPESAFE_API_KEY=
